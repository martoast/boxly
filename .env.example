
## Server-side AI provider. OpenAI is the default; use google or anthropic to roll back.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.6-luna
# Optional; falls back to OPENAI_CHAT_MODEL.
OPENAI_AUX_MODEL=

# Explicit rollback providers (configure only the selected provider's key).
# AI_PROVIDER=google
# GEMINI_API_KEY=
# GOOGLE_CHAT_MODEL=gemini-3.1-flash-lite-preview
# GOOGLE_AUX_MODEL=gemini-2.5-flash-lite
# AI_PROVIDER=anthropic
