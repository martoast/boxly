
# eBay Browse API — real secondhand prices for the panel's "Usado" section.
# From developer.ebay.com → Application Keysets → Production.
#   EBAY_CLIENT_ID     = the keyset's "App ID"
#   EBAY_CLIENT_SECRET = the keyset's "Cert ID"  (secret)
# Unset = the section falls back to the SerpAPI resale index, as today.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_ENV=production
